{
  "name": "@shotfolder/server",
  "version": "0.1.0",
  "private": true,
  "description": "Programa do PC: recebe fotos assinadas e grava só nas pastas permitidas",
  "license": "MIT",
  "type": "module",
  "bin": {
    "shotfolder": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/main.js",
    "start:local": "node dist/main.js --local",
    "enviar-teste": "node dist/tools/enviar-teste.js"
  },
  "dependencies": {
    "@shotfolder/protocol": "0.1.0",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
